# Copy to .env and adjust for your machine (pgAdmin 4 / local PostgreSQL)
NODE_ENV=development
PORT=4000
CLIENT_ORIGIN=http://localhost:5173

DATABASE_HOST=localhost
DATABASE_PORT=5432
DATABASE_NAME=textile_mill
DATABASE_USER=postgres
DATABASE_PASSWORD=postgres
DATABASE_POOL_SIZE=20
# Any single SQL statement is cancelled after this many milliseconds
DATABASE_STATEMENT_TIMEOUT_MS=7000

# Generate one with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=change-me-to-a-long-random-string
SESSION_HOURS=8

# Outgoing email for verification codes. Leave empty in development: the code is printed
# in this API's console instead. Example: smtps://user:password@smtp.yourcompany.com:465
SMTP_URL=
MAIL_FROM=MillOS <no-reply@yourcompany.com>

# Optional: lets `npm run platform:admin` run without asking for a password (scripted setups).
# PLATFORM_ADMIN_PASSWORD=
